def quotation_window():

    window = tk.Tk()
    window.title("Quotation System")
    window.geometry("360x650")

    customer = tk.StringVar()
    product = tk.StringVar()
    quantity = tk.StringVar()
    price = tk.StringVar()
    total = tk.StringVar()

  
    tk.Label(
        window,
        text="Small Business Quotation",
        font=("Arial", 17, "bold")
    ).pack(pady=15)

   
    tk.Label(window, text="Customer Name").pack()
    tk.Entry(
        window,
        textvariable=customer
    ).pack(fill="x", padx=25, pady=5)

    
    tk.Label(window, text="Product Name").pack()
    tk.Entry(
        window,
        textvariable=product
    ).pack(fill="x", padx=25, pady=5)

  
    tk.Label(window, text="Quantity").pack()
    tk.Entry(
        window,
        textvariable=quantity
    ).pack(fill="x", padx=25, pady=5)

   
    tk.Label(window, text="Price").pack()
    tk.Entry(
        window,
        textvariable=price
    ).pack(fill="x", padx=25, pady=5)

   
    def calculate():

        try:
            q = int(quantity.get())
            p = float(price.get())

            total.set(str(q * p))

        except:
            messagebox.showerror(
                "Error",
                "Enter valid quantity and price"
            )

    tk.Button(
        window,
        text="Calculate Total",
        command=calculate
    ).pack(pady=10)

    
    tk.Label(
        window,
        text="Total Amount",
        font=("Arial", 12, "bold")
    ).pack()

    tk.Label(
        window,
        textvariable=total,
        font=("Arial", 16, "bold")
    ).pack(pady=5)

   
    def save_quotation():

        if customer.get() == "" or product.get() == "":
            messagebox.showwarning(
                "Warning",
                "Enter customer and product"
            )
            return

        try:

            db = connect_database()
            cursor = db.cursor()

            sql = """
            INSERT INTO quotations
            (customer, product, quantity, price, total)
            VALUES (%s, %s, %s, %s, %s)
            """

            values = (
                customer.get(),
                product.get(),
                int(quantity.get()),
                float(price.get()),
                float(total.get())
            )

            cursor.execute(sql, values)
            db.commit()

            cursor.close()
            db.close()

            messagebox.showinfo(
                "Success",
                "Quotation Saved Successfully"
            )

        except Exception as e:

            messagebox.showerror(
                "Database Error",
                str(e)
            )

    tk.Button(
        window,
        text="Save Quotation",
        command=save_quotation
    ).pack(fill="x", padx=25, pady=10)

    
    def clear():

        customer.set("")
        product.set("")
        quantity.set("")
        price.set("")
        total.set("")

    tk.Button(
        window,
        text="Clear",
        command=clear
    ).pack(fill="x", padx=25)

    window.mainloop()



